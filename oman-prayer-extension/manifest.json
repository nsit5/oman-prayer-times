{
  "manifest_version": 3,
  "name": "مواقيت الصلاة - سلطنة عُمان",
  "version": "2.1",
  "description": "مواقيت الصلاة لجميع ولايات سلطنة عُمان مع إشعارات الأذان والإقامة",
  "permissions": [
    "notifications",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.mara.gov.om/*",
    "https://www.mara.gov.om/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mara.gov.om/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "adhan.mp3",
        "icons/*"
      ],
      "matches": [
        "*://*.mara.gov.om/*",
        "<all_urls>"
      ]
    }
  ]
}